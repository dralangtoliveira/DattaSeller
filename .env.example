NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
DATTA360_WEBHOOK_SECRET=generate-a-random-secret
RESEND_API_KEY=re_REPLACE_ME

# E2E HML — usar somente Preview/HML isolado; nunca Production.
# Preencha com recursos aprovados, mas mantenha DS_E2E_CONFIRM vazio até a
# autorização humana explícita. O runner aceita exclusivamente o literal "yes".
DS_E2E_BASE_URL=https://preview-hml.example.test
DS_E2E_EMAIL=admin@controlled.example.test
DS_E2E_PASSWORD=REPLACE_WITH_HML_ADMIN_PASSWORD
DS_E2E_EXPECTED_SUPABASE_REF=PROJECT_REF
DS_E2E_EMAIL_TO=mailbox@controlled.example.test
DS_E2E_CONFIRM=

# Descoberta real (DS-VALUE-01) — provedor padrão: OpenStreetMap (Nominatim + Overpass).
# Não exige chave. As variáveis abaixo são opcionais e servem para apontar outro
# espelho do mesmo provedor ou identificar o cliente no uso das APIs públicas.
DATTASELLER_DISCOVERY_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
DATTASELLER_DISCOVERY_OVERPASS_URL=https://overpass-api.de/api/interpreter
DATTASELLER_DISCOVERY_CONTACT=DattaSeller CRM (+https://crm.datta360.com.br)
